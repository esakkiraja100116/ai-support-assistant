DATABASE_URL=postgresql+psycopg://support:support@localhost:5433/support_assistant
OPENAI_API_KEY=sk-replace-me
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RESOLVE_MODEL=gpt-5.6-sol
RESOLVE_REASONING_EFFORT=none
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
KB_MIN_SIMILARITY=0.30
CORS_ORIGINS=http://localhost:3000
SUPPORT_CONTACT_EMAIL=support@example.com
ESCALATION_DECLINE_THRESHOLD=2

# Redemption order tracking (Redis cache + mock internal tracking API)
REDIS_URL=redis://localhost:6380/0
INTERNAL_TRACKING_BASE_URL=http://localhost:8000

# OpenTelemetry tracing (Grafana Cloud) - leave blank to disable tracing
# entirely (safe no-op). ENVIRONMENT should be "local" here and "cloud" in
# the deployed backend's own env vars, so traces are filterable by origin.
ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
